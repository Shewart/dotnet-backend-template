<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Dotnet.Backend.Template</id>
    <version>1.1.0</version>
    <title>.NET Backend Template</title>
    <authors>dotnet-backend-template</authors>
    <owners>dotnet-backend-template</owners>
    <description>A production-ready .NET backend template with Clean Architecture, MongoDB/PostgreSQL support, and Minimal APIs. Get from zero to production-ready API in minutes with proper layering, generic CRUD operations, and extensible design.</description>
    <summary>Clean Architecture .NET backend template with MongoDB/PostgreSQL and Minimal APIs</summary>
    <releaseNotes>Added PostgreSQL support with Entity Framework Core. Enhanced template with multiple database provider options.</releaseNotes>
    <copyright>Copyright © 2025</copyright>
    <language>en-US</language>
    <tags>dotnet template web api backend mongodb postgresql entity-framework clean-architecture minimal-api csharp</tags>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/shewart/dotnet-backend-template</projectUrl>
    <repository type="git" url="https://github.com/shewart/dotnet-backend-template.git" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <developmentDependency>true</developmentDependency>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <file src="**" target="content" exclude="**/*.nupkg;**/*.user;**/bin/**;**/obj/**;.vs/**;.git/**;*.md" />
    <file src="README.md" target="content" />
    <file src="MongoDB-README.md" target="content" />
    <file src="PostgreSQL-README.md" target="content" />
    <file src="LICENSE" target="content" />
  </files>
</package>
